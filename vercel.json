{
  "rewrites": [
    {
      "source": "/((?!api/|bg-sezon15/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/bg-sezon15",
      "destination": "/bg-sezon15/",
      "permanent": false
    }
  ]
}
